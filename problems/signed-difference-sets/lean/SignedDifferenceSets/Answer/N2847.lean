/-!
# N2847: no (117, 53, 17) SDS in C₁₁₇

Open in Gordon's table (`SDS(117,53,17,[117])`, 2026-11-05).
Contract along C₁₁₇ → C₉ (C3): fibres of 13 elements, so the coset
sums lie in [−13, 13], have square sum 53 + 17 · 12 = 257, sum ±45 and
autocorrelation 17 · 13 = 221 at every shift ≠ 0; `noVector` (`decide +kernel`)
finds no such vector. Quotient from E5; this file is generated by `solver/answer.py`.
-/

@[expose] public section

namespace SignedDifferenceSets.Answer.N2847

-- one kernel check at a time: the subtree checks together hold too much memory
set_option Elab.async false

/-- The projection C₁₁₇ → C₉, factor by factor. -/
def proj : Proj (ZMod 117) (ZMod 9) :=
  .cast 9 (by norm_num)

/-- `below` with this Instance's search arguments (those `not_hasSDS_of_noVector` asks for). -/
abbrev check (p : List ℤ) : Bool :=
  below (Indexed.size (ZMod 9)) (Indexed.addIdx (ZMod 9)) (13 : ℕ)
    ((53 : ℕ) + (17 : ℤ) * ((13 : ℕ) - 1)) ((17 : ℤ) * (13 : ℕ)) (53 : ℕ) 45 p

/-- A prefix stored as one number: coordinate `i` plus 13 is its base-27 digit `i`. -/
def decodePrefix (x : ℕ) : List ℤ :=
  (List.range 4).map fun i => ((x / 27 ^ i % 27 : ℕ) : ℤ) - 13

