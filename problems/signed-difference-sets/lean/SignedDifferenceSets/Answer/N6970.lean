/-!
# N6970: no (171, 154, 135) SDS in C₃ × C₅₇

Open in Gordon's table (`SDS(171,154,135,[3,57])`, 2026-11-05).
Contract along C₃ × C₅₇ → C₃ × C₃ (C3): fibres of 19 elements, so the coset
sums lie in [−19, 19], have square sum 154 + 135 · 18 = 2584, sum ±152 and
autocorrelation 135 · 19 = 2565 at every shift ≠ 0; `noVector` (`decide +kernel`)
finds no such vector. Quotient from E5; this file is generated by `solver/answer.py`.
-/

@[expose] public section

namespace SignedDifferenceSets.Answer.N6970

-- one kernel check at a time: the subtree checks together hold too much memory
set_option Elab.async false

/-- The projection C₃ × C₅₇ → C₃ × C₃, factor by factor. -/
def proj : Proj (ZMod 3 × ZMod 57) (ZMod 3 × ZMod 3) :=
  .prod (.cast 3 (by norm_num))
    (.cast 3 (by norm_num))

/-- `below` with this Instance's search arguments (those `not_hasSDS_of_noVector` asks for). -/
abbrev check (p : List ℤ) : Bool :=
  below (Indexed.size (ZMod 3 × ZMod 3)) (Indexed.addIdx (ZMod 3 × ZMod 3)) (19 : ℕ)
    ((154 : ℕ) + (135 : ℤ) * ((19 : ℕ) - 1)) ((135 : ℤ) * (19 : ℕ)) (154 : ℕ) 152 p

/-- A prefix stored as one number: coordinate `i` plus 19 is its base-39 digit `i`. -/
def decodePrefix (x : ℕ) : List ℤ :=
  (List.range 4).map fun i => ((x / 39 ^ i % 39 : ℕ) : ℤ) - 19

