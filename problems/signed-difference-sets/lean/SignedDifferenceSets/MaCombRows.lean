`c = 5`, `p^b = 2^2`, `Q = 3^1`. -/
theorem n6822_not_hasSDS : ¬ HasSDS (ZMod 170) 146 2 :=
  not_hasSDS_of_mem_maCombRows (x := (⟨6822, [170], 146, 2⟩,
      ⟨2, 1, 4, 4, 2, [17], [[1], [1]],
        [[17], [18]], [(3, 8, 1)]⟩)) (by decide +kernel) _

