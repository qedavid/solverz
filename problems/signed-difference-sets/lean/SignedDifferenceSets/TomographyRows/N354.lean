/-- The nodes the top levels leave to the batches. -/
def front : List (List (List ℤ)) :=
  batch0 ++ (batch1 ++ (batch2 ++ (batch3 ++ (batch4 ++ (batch5 ++ (batch6 ++ batch7))))))

theorem htop : tomoTop 7 15 w front 1 rows [] = true := by
  decide +kernel

theorem hT : tomoGo 7 15 w rows [] = true :=
  tomoGo_of_top 1 rows [] htop fun q hq => by
    simp only [front, List.mem_append] at hq
    rcases hq with h | h | h | h | h | h | h | h
    · exact List.all_eq_true.1 tpart0 q h
    · exact List.all_eq_true.1 tpart1 q h
    · exact List.all_eq_true.1 tpart2 q h
    · exact List.all_eq_true.1 tpart3 q h
    · exact List.all_eq_true.1 tpart4 q h
    · exact List.all_eq_true.1 tpart5 q h
    · exact List.all_eq_true.1 tpart6 q h
    · exact List.all_eq_true.1 tpart7 q h

/-- N354: C7 × C7 has no signed difference set with parameters (49, 33, 4). -/
theorem not_hasSDS : ¬ HasSDS (ZMod 7 × ZMod 7) 33 4 :=
  @Tomography.not_hasSDS 7 ⟨by norm_num⟩ 33 (4) 15 (by norm_num) (by decide) v0 w ws
    rows hV hW hc hR hT

end SignedDifferenceSets.TomographyRows.N354
