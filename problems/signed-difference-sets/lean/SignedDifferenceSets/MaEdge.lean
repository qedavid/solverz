module

public import SignedDifferenceSets.MaDescentFull

/-!
# C33: Ma's lemma at its edge forces `p ∣ λ c`

On a C21 quotient `H = ZMod (r p) × K` (`p^i h = −h` on `K`, `p^e ∣ k − λ`, `1 ≤ b ≤ e/2`),
the coset sums `Y` of an SDS satisfy `p ∣ Y(h + u) − Y(h)` for `u = (r, 0)`
(`Ma.dvd_contract_sub`). The coset sums `W` along `ZMod (r p) × K → ZMod r × K` add up `p`
values of `Y` that agree mod `p`, so `p ∣ W`. At a shift `g ≠ 0` their autocorrelation is
`λ p c` (C3), now divisible by `p²`: so `p ∣ λ c` (`IsSDS.dvd_lam_mul_of_ma`). Hence a cyclic
Sylow `p`-subgroup of order `p^j`, `j ≥ 2`, with `p² ∣ k − λ` and `p ∤ λ` leaves no SDS;
`MaEdgeCert` checks a row by `decide +kernel`.
-/

@[expose] public section

namespace SignedDifferenceSets

open Ma

/-- C33: on a C21 quotient with `b ≥ 1`, `p` divides `λ c` (`c` the fibre size), given a nonzero
element of `ZMod r × K`. -/
theorem IsSDS.dvd_lam_mul_of_ma {G K : Type} [AddCommGroup G] [Fintype G] [AddCommGroup K]
    [Fintype K] {p r i e b c k : ℕ} {lam : ℤ} [hp : Fact p.Prime]
    [NeZero (r * p)] [NeZero r] {φ : G →+ ZMod (r * p) × K} (hφ : Function.Surjective φ)
    (hcard : Fintype.card G = c * Fintype.card (ZMod (r * p) × K)) (hr : 0 < r) (hi : 0 < i)
    (hc : ∀ x : K, p ^ i • x = -x) (hn : (p : ℤ) ^ e ∣ (k : ℤ) - lam) (hb : 2 * b ≤ e)
    (hb1 : 0 < b) (hcert : CycloFacts p r) {D : G → SignType} (hD : IsSDS k lam D)
    {g : ZMod r × K} (hg : g ≠ 0) : (p : ℤ) ∣ lam * c := by
  classical
  set ψ : ZMod (r * p) × K →+ ZMod r × K :=
    ((ZMod.castHom (dvd_mul_right r p) (ZMod r)).toAddMonoidHom).prodMap (AddMonoidHom.id K)
    with hψdef
  have hψ : Function.Surjective ψ := by
    rintro ⟨a, b⟩
    obtain ⟨a', ha'⟩ := ZMod.ringHom_surjective (ZMod.castHom (dvd_mul_right r p) (ZMod r)) a
    exact ⟨(a', b), by simp [hψdef, ha']⟩
  set u : ZMod (r * p) × K := ((r : ZMod (r * p)), 0) with hu
  set χ := ψ.comp φ with hχdef
  have hχ : Function.Surjective χ := hψ.comp hφ
  have hcardH : Fintype.card (ZMod (r * p) × K) = p * Fintype.card (ZMod r × K) := by
    rw [Fintype.card_prod, Fintype.card_prod, ZMod.card, ZMod.card]
    ring
  have hcardp : Fintype.card G = p * c * Fintype.card (ZMod r × K) := by
    rw [hcard, hcardH]
    ring
  set Y := contract φ D with hYdef
  set W := contract χ D with hWdef
  have hstep : ∀ h, (p : ℤ) ∣ Y (h + u) - Y h := by
    rintro ⟨x, kk⟩
    have := Ma.dvd_contract_sub hφ hcard hr hi hc hn hb hcert hD x kk
    exact (dvd_pow_self (p : ℤ) hb1.ne').trans (by simpa [hu] using this)
  have hiter : ∀ (m : ℕ) h, (p : ℤ) ∣ Y (h + m • u) - Y h := by
    intro m
    induction m with
    | zero => intro h; simp
    | succ m ih =>
      intro h
      have := dvd_add (hstep (h + m • u)) (ih h)
      rw [succ_nsmul, ← add_assoc]
      convert this using 1
      ring
  -- the kernel of `ψ` is generated by `u`
  have hker : ∀ d, ψ d = 0 → ∃ m : ℕ, d = m • u := by
    rintro ⟨d1, d2⟩ hd
    have h1 : ZMod.castHom (dvd_mul_right r p) (ZMod r) d1 = 0 := congrArg Prod.fst hd
    have h2 : d2 = 0 := congrArg Prod.snd hd
    rw [ZMod.castHom_apply, ZMod.cast_eq_val] at h1
    obtain ⟨m, hm⟩ := (ZMod.natCast_eq_zero_iff _ _).1 h1
    refine ⟨m, Prod.ext ?_ (by simp [hu, h2])⟩
    simp only [hu, Prod.smul_fst, nsmul_eq_mul]
    rw [← ZMod.natCast_zmod_val d1, hm, Nat.cast_mul]
    ring
  have hW : ∀ y, (p : ℤ) ∣ W y := by
    intro y
    obtain ⟨h, rfl⟩ := hψ y
    rw [hWdef, hχdef, contract_comp]
    have hfib := card_fibre_eq hψ hcardH (ψ h)
    rw [fibre] at hfib
    have hsplit : ∑ h' ∈ Finset.univ.filter (fun h' => ψ h' = ψ h), Y h' =
        ∑ h' ∈ Finset.univ.filter (fun h' => ψ h' = ψ h), (Y h' - Y h) + (p : ℤ) * Y h := by
      rw [Finset.sum_sub_distrib, Finset.sum_const, hfib, nsmul_eq_mul]
      ring
    rw [hsplit]
    refine dvd_add (Finset.dvd_sum fun h' hh' => ?_) (dvd_mul_right _ _)
    have hh' : ψ (h' - h) = 0 := by
      rw [map_sub, (Finset.mem_filter.1 hh').2, sub_self]
    obtain ⟨m, hm⟩ := hker _ hh'
    have : h' = h + m • u := by rw [← hm]; abel
    rw [this]
    exact hiter m h
  have hac := hD.contract_autocorr χ g hg
  rw [← hWdef, card_fibre_eq hχ hcardp] at hac
  have hsq : (p : ℤ) ^ 2 ∣ ∑ y, W y * W (y + g) :=
    Finset.dvd_sum fun y _ => by rw [pow_two]; exact mul_dvd_mul (hW y) (hW (y + g))
  rw [hac] at hsq
  have hp0 : (p : ℤ) ≠ 0 := by exact_mod_cast hp.out.ne_zero
  have : (p : ℤ) * p ∣ (p : ℤ) * (lam * c) := by
    rw [← pow_two]
    convert hsq using 1
    push_cast
    ring
  exact (mul_dvd_mul_iff_left hp0).1 this

/-! ### Rows -/

/-- A C33 certificate: C21's fields (`p`, `r = p^(j−1)`, `i`, `e`, `b`, `ks ≠ []`, forms `A` onto
`ZMod (r p) × Grp ks` with preimages `P`). -/
structure MaEdgeCert where
  p : ℕ
  r : ℕ
  i : ℕ
  e : ℕ
  b : ℕ
  ks : List ℕ
  A : List (List ℕ)
  P : List (List ℕ)
  deriving DecidableEq

/-- C33's hypotheses on the row (`r > 1`, `b ≥ 1`, `(p, r)` among `MaRows.maPairs`) and the kill
`p ∤ λ c`, `c = |G| / (r p |K|)`. -/
def MaEdgeCert.Kills (w : Row) (c : MaEdgeCert) : Prop :=
  IsPrimeTD c.p ∧ 1 < c.r ∧ 0 < c.i ∧ c.ks ≠ [] ∧ (∀ d ∈ c.ks, d ∣ c.p ^ c.i + 1) ∧
    MapOk w.ms (c.r * c.p :: c.ks) c.A ∧ SurjCert w.ms (c.r * c.p :: c.ks) c.A c.P ∧
    c.r * c.p * c.ks.prod ∣ w.ms.prod ∧ (c.p : ℤ) ^ c.e ∣ w.k - w.lam ∧ 2 * c.b ≤ c.e ∧
    0 < c.b ∧ ¬ (c.p : ℤ) ∣ w.lam * (w.ms.prod / (c.r * c.p * c.ks.prod) : ℕ) ∧
    (c.p, c.r) ∈ MaRows.maPairs

instance (w : Row) (c : MaEdgeCert) : Decidable (c.Kills w) := by
  unfold MaEdgeCert.Kills; infer_instance

/-- A row C33 kills has no SDS, whatever `Fintype` instance its group carries. -/
theorem MaEdgeCert.not_hasSDS {w : Row} {c : MaEdgeCert} (h : c.Kills w)
    (inst : Fintype (Grp w.ms)) : ¬ @HasSDS (Grp w.ms) _ inst w.k w.lam := by
  obtain ⟨hp, hr, hi, hne, hks, hmap, hsurj, hprod, hn, hbe, hb1, hkill, hpair⟩ := h
  rintro ⟨D, hD⟩
  obtain ⟨k₀, ks, hks0⟩ := List.exists_cons_of_ne_nil hne
  rw [hks0] at hks hmap hsurj hprod hkill
  have : Fact c.p.Prime := ⟨hp.prime⟩
  have : NeZero (c.r * c.p) := ⟨(Nat.mul_pos (by omega) hp.prime.pos).ne'⟩
  have : NeZero c.r := ⟨by omega⟩
  let _ : Fintype (Grp (k₀ :: ks)) :=
    Grp.fintype _ fun d hd => Nat.pos_of_dvd_of_pos (hks d hd) (by positivity)
  let φ : Grp w.ms →+ ZMod (c.r * c.p) × Grp (k₀ :: ks) :=
    linMap w.ms (c.r * c.p :: k₀ :: ks) c.A hmap
  have hφ : Function.Surjective φ := linMap_surjective hmap hsurj
  have hcard : Fintype.card (Grp w.ms) = w.ms.prod / (c.r * c.p * (k₀ :: ks).prod) *
      Fintype.card (ZMod (c.r * c.p) × Grp (k₀ :: ks)) := by
    rw [Fintype.card_prod, ZMod.card, Grp.card_eq, Grp.card_eq, Nat.div_mul_cancel hprod]
  have hconj (x : Grp (k₀ :: ks)) : c.p ^ c.i • x = -x := by
    have := Grp.nsmul_eq_zero (N := c.p ^ c.i + 1) (k₀ :: ks) hks x
    rw [add_smul, one_smul] at this
    exact eq_neg_of_add_eq_zero_left this
  have hg : ((1 : ZMod c.r), (0 : Grp (k₀ :: ks))) ≠ 0 := by
    intro h0
    have h1 := congrArg (fun z => (Prod.fst z).val) h0
    simp only [Prod.fst_zero, ZMod.val_zero] at h1
    rw [ZMod.val_one'' (by omega)] at h1
    exact one_ne_zero h1
  exact hkill (hD.dvd_lam_mul_of_ma hφ hcard (by omega) hi hconj hn hbe hb1
    (MaRows.cycloFacts_of_mem_maPairs hpair) hg)

end SignedDifferenceSets
