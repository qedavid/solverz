/-- `h ≡ 2 ^ ex h · rep (orb h) (mod 7)`. -/
def ex : List ℕ :=
  [0, 0, 1, 0, 2, 2, 1]

/-- The centred line vectors constant on the orbits. -/
def w : List (List ℤ) :=
  [[13, 6, 6, 12, 6, 12, 12], [13, 12, 12, 6, 12, 6, 6]]

theorem ho : orbOK 7 2 orb sz rep ex = true := by decide +kernel

-- 496 nodes
theorem hV : orbSearch (Indexed.size (ZMod 7)) (Indexed.addIdx (ZMod 7)) (3 * 7 : ℕ)
