/-- The orbits' smallest elements. -/
def rep : List ℕ :=
  [0, 1, 3]

/-- `h ≡ 2 ^ ex h · rep (orb h) (mod 7)`. -/
def ex : List ℕ :=
  [0, 0, 1, 0, 2, 2, 1]

/-- The centred line vectors constant on the orbits. -/
def w : List (List ℤ) :=
  [[-3, 8, 8, 10, 8, 10, 10], [-3, 10, 10, 8, 10, 8, 8]]

theorem ho : orbOK 7 2 orb sz rep ex = true := by decide +kernel

-- 533 nodes
theorem hV : orbSearch (Indexed.size (ZMod 7)) (Indexed.addIdx (ZMod 7)) (5 * 7 : ℕ)
