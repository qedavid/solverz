  decide +kernel

theorem hpt : ptOK 7 51 w 0 = true := by decide +kernel

/-- N15446: `ZMod 7 × ZMod 35` has no signed difference set with parameters
(245, 161, 10). -/
theorem not_hasSDS : ¬ HasSDS (ZMod 7 × ZMod 35) 161 10 :=
  not_hasSDS_grp (ms := [7, 35]) 7 (A := [[1, 0], [0, 1]]) (P := [[1, 0], [0, 1]])
    (by decide) (by decide) _ (c := 5) (by decide) (by norm_num) (by decide) (t := 2)
