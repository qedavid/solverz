/-- The factors of the divided quotient `Grp [3, 2, 2, 2]` are positive. -/
theorem hpos : ∀ m ∈ [3, 2, 2, 2], 0 < m := by decide

/-- `below` with this row's divided search arguments (those `MaDivCert.not_hasSDS` asks for). -/
abbrev check (p : List ℤ) : Bool :=
  below (@Indexed.size (Grp [3, 2, 2, 2]) _ (Grp.indexed _ hpos))
    (@Indexed.addIdx (Grp [3, 2, 2, 2]) _ (Grp.indexed _ hpos))
    (3 : ℕ) (12 : ℤ) (8 : ℤ) (14 : ℕ) 14 p

/-- A prefix stored as one number: coordinate `i` plus 3 is its base-7 digit `i`. -/
def decodePrefix (x : ℕ) : List ℤ :=
  (List.range 4).map fun i => ((x / 7 ^ i % 7 : ℕ) : ℤ) - 3

