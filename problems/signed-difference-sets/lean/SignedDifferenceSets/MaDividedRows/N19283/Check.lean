/-- The factors of the divided quotient `Grp [3, 10]` are positive. -/
theorem hpos : ∀ m ∈ [3, 10], 0 < m := by decide

/-- `below` with this row's divided search arguments (those `MaDivCert.not_hasSDS` asks for). -/
abbrev check (p : List ℤ) : Bool :=
  below (@Indexed.size (Grp [3, 10]) _ (Grp.indexed _ hpos))
    (@Indexed.addIdx (Grp [3, 10]) _ (Grp.indexed _ hpos))
    (3 : ℕ) (6 : ℤ) (2 : ℤ) (12 : ℕ) 8 p

/-- A prefix stored as one number: coordinate `i` plus 3 is its base-7 digit `i`. -/
def decodePrefix (x : ℕ) : List ℤ :=
  (List.range 7).map fun i => ((x / 7 ^ i % 7 : ℕ) : ℤ) - 3

