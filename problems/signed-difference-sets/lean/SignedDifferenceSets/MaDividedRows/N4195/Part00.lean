module

public import SignedDifferenceSets.MaDividedRows.N4195.Check

/-!
# N4195: prefix batches 0–1

27156 search nodes in 2 kernel checks of at most 25000;
generated by `solver/madividedrows.py`.
-/

@[expose] public section

namespace SignedDifferenceSets.MaDividedRows.N4195

-- one kernel check at a time: the subtree checks together hold too much memory
set_option Elab.async false

/-- Prefixes, batch 0 (22524 nodes). -/
def batch0 : List (List ℤ) :=
  List.map decodePrefix [
    18, 25, 32, 12, 19, 26, 33, 40, 6, 13, 20, 27, 34, 41]

set_option maxRecDepth 100000 in
theorem below0 : ∀ p ∈ batch0, check p = true := by
  decide +kernel

/-- Prefixes, batch 1 (4632 nodes). -/
def batch1 : List (List ℤ) :=
  List.map decodePrefix [
    48]

set_option maxRecDepth 100000 in
theorem below1 : ∀ p ∈ batch1, check p = true := by
  decide +kernel

end SignedDifferenceSets.MaDividedRows.N4195
