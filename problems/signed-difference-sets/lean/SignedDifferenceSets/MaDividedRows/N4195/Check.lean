/-- The factors of the divided quotient `Grp [3, 5]` are positive. -/
theorem hpos : ∀ m ∈ [3, 5], 0 < m := by decide

/-- `below` with this row's divided search arguments (those `MaDivCert.not_hasSDS` asks for). -/
abbrev check (p : List ℤ) : Bool :=
  below (@Indexed.size (Grp [3, 5]) _ (Grp.indexed _ hpos))
    (@Indexed.addIdx (Grp [3, 5]) _ (Grp.indexed _ hpos))
    (3 : ℕ) (72 : ℤ) (68 : ℤ) (34 : ℕ) 32 p

/-- A prefix stored as one number: coordinate `i` plus 3 is its base-7 digit `i`. -/
def decodePrefix (x : ℕ) : List ℤ :=
  (List.range 2).map fun i => ((x / 7 ^ i % 7 : ℕ) : ℤ) - 3

