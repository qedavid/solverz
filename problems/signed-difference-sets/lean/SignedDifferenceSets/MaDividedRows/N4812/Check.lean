/-- The factors of the divided quotient `Grp [3, 2, 4]` are positive. -/
theorem hpos : ∀ m ∈ [3, 2, 4], 0 < m := by decide

/-- `below` with this row's divided search arguments (those `MaDivCert.not_hasSDS` asks for). -/
abbrev check (p : List ℤ) : Bool :=
  below (@Indexed.size (Grp [3, 2, 4]) _ (Grp.indexed _ hpos))
    (@Indexed.addIdx (Grp [3, 2, 4]) _ (Grp.indexed _ hpos))
    (2 : ℕ) (52 : ℤ) (48 : ℤ) (36 : ℕ) 34 p

/-- A prefix stored as one number: coordinate `i` plus 2 is its base-5 digit `i`. -/
def decodePrefix (x : ℕ) : List ℤ :=
  (List.range 5).map fun i => ((x / 5 ^ i % 5 : ℕ) : ℤ) - 2

