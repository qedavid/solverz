def SignedDifferenceSets.HasSDS.{u_1} : (G : Type u_1) → [AddCommGroup G] → [Fintype G] → ℕ → ℤ → Prop :=
fun G [AddCommGroup G] [Fintype G] k lam => ∃ D, SignedDifferenceSets.IsSDS k lam D
def SignedDifferenceSets.IsSDS.{u_1} : {G : Type u_1} →
  [AddCommGroup G] → [Fintype G] → ℕ → ℤ → (G → SignType) → Prop :=
fun {G} [AddCommGroup G] [Fintype G] k lam D =>
  {x | D x ≠ 0}.card = k ∧ ∀ (g : G), g ≠ 0 → ∑ x, ↑(D x) * ↑(D (x + g)) = lam

