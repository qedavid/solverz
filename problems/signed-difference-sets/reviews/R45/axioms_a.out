Tomography.not_hasSDS : ∀ (p : ℕ) [inst : Fact (Nat.Prime p)] {k : ℕ} {lam s : ℤ},
  s * s = ↑k + lam * (↑p * ↑p - 1) →
    ↑s ≠ 0 →
      ∀ {V0 W : List (List ℤ)} {ws : List (List (List ℤ))} {R : List (List Tomography.Row)},
        Tomography.inSearch (Indexed.size (ZMod p)) (Indexed.addIdx (ZMod p)) (↑p) (↑k + lam * (↑p - 1)) (lam * ↑p) (↑k)
              s V0 =
            true →
          Tomography.rotOK p V0 W = true →
            Tomography.certOK p ws = true →
              Tomography.certRows p s ws = R → Tomography.tomoGo p s W R [] = true → ¬HasSDS (ZMod p × ZMod p) k lam
Tomography.not_hasSDS_prime : ∀ (p : ℕ) [inst : Fact (Nat.Prime p)] {k : ℕ} {lam s : ℤ} (n : ℕ),
  Nat.Prime n →
    ↑k - lam = ↑n →
      ↑n ≠ 0 →
        ↑n ≠ 1 →
          s * s = ↑k + lam * (↑p * ↑p - 1) →
            ↑s ≠ 0 →
              ∀ {fr ex : List ℕ},
                Tomography.frOK p n fr ex = true →
                  ∀ {W : List (List ℤ)} {ws : List (List (List ℤ))} {R : List (List Tomography.Row)},
                    Tomography.fixSearch (Indexed.size (ZMod p)) (Indexed.addIdx (ZMod p)) (↑p) (↑k + lam * (↑p - 1))
                          (lam * ↑p) (↑k) s fr W =
                        true →
                      Tomography.certOK p ws = true →
                        Tomography.certRows p s ws = R →
                          Tomography.tomoGo p s W R [] = true → ¬HasSDS (ZMod p × ZMod p) k lam
@Tomography.fixed_line : ∀ {p : ℕ} [hp : Fact (Nat.Prime p)] {k : ℕ} {lam s : ℤ} {D : ZMod p × ZMod p → SignType},
  IsSDS k lam D →
    ∑ x, ↑(D x) = s →
      ↑s ≠ 0 →
        Tomography.Centered D →
          ∀ {n : ℕ},
            Nat.Prime n →
              ↑k - lam = ↑n →
                ↑n ≠ 0 →
                  ↑n ≠ 1 →
                    ∀ (j : ℕ) (h : ZMod p),
                      contract (Tomography.lineMap p j) D (↑n * h) = contract (Tomography.lineMap p j) D h

